{
  "name": "Map Method",
  "short_name": "Map Method",
  "description": "Превращайте цели в наглядные карты прогресса.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "launch_handler": { "client_mode": "navigate-existing" },
  "protocol_handlers": [
    { "protocol": "web+mapmethod", "url": "/?launch=%s" }
  ],
  "background_color": "#f5f2eb",
  "theme_color": "#32624f",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/mm-logo.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ]
}
